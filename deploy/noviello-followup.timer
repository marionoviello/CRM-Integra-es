[Unit]
Description=Run Noviello scheduler (poll active conversations + follow-up cycle)

[Timer]
# Poll-based architecture (confirmed 2026-06-07 — Jurichat has no
# per-message webhook event). One tick runs both:
#   run_poll_cycle      → active em_conversa leads (60s cadence)
#   run_followup_cycle  → idle leads needing FU1/FU2/closure
# The 1-minute interval is the upper bound on lead response latency.
OnBootSec=30s
OnUnitActiveSec=1min
AccuracySec=15s
Persistent=true
Unit=noviello-followup.service

[Install]
WantedBy=timers.target

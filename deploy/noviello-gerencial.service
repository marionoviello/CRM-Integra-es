[Unit]
Description=Noviello Funil Saude - Relatorio gerencial (pulso da operacao)
After=network.target

[Service]
Type=oneshot
TimeoutStartSec=120
User=noviello
Group=noviello
WorkingDirectory=/opt/noviello-funil-saude
EnvironmentFile=/opt/noviello-funil-saude/.env
ExecStart=/opt/noviello-funil-saude/.venv/bin/noviello-gerencial
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

# Template público — copie para .env (gitignored) e preencha valores reais
# NUNCA commitar o .env real

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Groq Whisper — transcrição de áudios do lead (vazio = bot não transcreve).
# Gere em console.groq.com. NUNCA colar a chave real aqui — só no .env.
GROQ_API_KEY=
# Modelos (opcional — defaults no config.py). Triagem = decisão/resposta ao lead
# (precisão máxima); follow-up = mensagens de retomada (mais leve).
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_FOLLOWUP=claude-sonnet-4-6

# Jurichat
JURICHAT_API_KEY=
JURICHAT_WEBHOOK_SECRET=
JURICHAT_BASE_URL=https://api.jurichat.com

# ID da inbox Jurichat que o bot atende. Veja em qualquer payload de webhook
# como data.inboxId (ex: cmhphehs612ucpp0ilvlf0c9v)
JURICHAT_INBOX_ID=
# OBRIGATÓRIO em prod: ID do usuário do bot no Jurichat. Sem ele, a detecção de
# "humano assumiu a conversa" (Signal 0) fica DESLIGADA — o bot pode atropelar
# você quando assume um atendimento pelo painel, e cada envio pode re-sortear
# o atendente (isRandom).
JURICHAT_BOT_USER_ID=

# Espera-humano: min. de silêncio do humano antes do bot voltar a responder.
# Quando alguém DIGITA no painel (msg com prefixo "Noviello Advocacia:"), o
# bot só reage a uma msg nova do lead >= este tempo depois. Default 60; 0=off.
BOT_ESPERA_HUMANO_MIN=60

# Anti-rajada: segundos de silêncio do lead antes do bot responder — dá tempo
# dele terminar de digitar mensagens em sequência. Default 90; 0=off.
BOT_ESPERA_RAJADA_SEG=90

# Reenvio automático quando o WhatsApp NÃO entrega uma mensagem nossa
# (externalStatus=FAILED). A detecção e o aviso ao Mario valem sempre; isto
# aqui só liga o reenvio do texto ao cliente (1× por mensagem).
REENVIO_FALHA_ATIVO=false

# Notificações pra Mario (número WhatsApp pessoal, formato E.164: 55119...)
NOTIFICACAO_TELEFONE=

# ID da conversa no Jurichat onde o bot manda notificações pro Mario
# Aceita múltiplos ids separados por vírgula (todos recebem notificações)
MARIO_CONVERSATION_ID=

# SQLite
DATABASE_PATH=./data/noviello.db

# App
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Throttling
MAX_TURNOS_POR_LEAD=20
THROTTLE_MSG_POR_SEGUNDO=1

# Follow-up timers (em horas)
FOLLOWUP_1_APOS_HORAS=48
FOLLOWUP_2_APOS_HORAS=72
ENCERRAMENTO_APOS_HORAS=24

# Google Calendar — janela de MANHÃ opcional (2026-06-16). Por padrão o bot
# só oferece a tarde (14-19h). Preenchendo abaixo (ex.: 10 e 12), ele passa
# a oferecer manhã + tarde. As audiências do Mario já estão na agenda → o
# free/busy as pula, então nunca oferece horário ocupado. 0/0 = só tarde.
CALENDAR_MORNING_START=0
CALENDAR_MORNING_END=0

# D4 (25/jun): sync de reuniões marcadas FORA do bot. A cada ciclo lê os eventos
# do Calendar (janela 48h) e auto-vincula ao lead pelo email do convidado (manda
# lembretes); eventos com convidado externo que não casam viram alerta 1× ao
# Mario. true = ligado (default). Desligar (false) se virar barulho.
CALENDAR_SYNC_MANUAL=true

# SMTP + IMAP (Google Workspace) — email de aniversário e detecção de
# bounce. SMTP_PASSWORD é uma SENHA DE APP (myaccount.google.com/
# apppasswords, exige 2FA); a mesma serve pro IMAP. Vazio = desligado.
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# 1.1: publicação urgente vira TAREFA no Juridiq. PUBLICACOES_CRIAR_TAREFA
# liga o POST /task/ (default off). TASK_COLUMN_ID = UUID da coluna do
# kanban onde os prazos nascem (achado via API; "Pendente" no escritório).
PUBLICACOES_CRIAR_TAREFA=false
TASK_COLUMN_ID=
TASK_PRIORITY=Alta

# 3.x: fechamento de contrato de honorários via ZapSign (1-toque humano).
# CONTRATOS_ZAPSIGN liga a feature (default off). Token no painel ZapSign
# (Integrações → API). ZAPSIGN_WEBHOOK_SECRET = valor longo aleatório que
# cadastramos como header secreto do webhook (a ZapSign não assina com HMAC).
# ZAPSIGN_TEMPLATE_HONORARIOS_ID = id do modelo DOCX de honorários no painel.
# Só honorários por ora (procuração fica fora até confirmar no foro).
CONTRATOS_ZAPSIGN=false
ZAPSIGN_API_TOKEN=
ZAPSIGN_BASE_URL=https://api.zapsign.com.br/api/v1
ZAPSIGN_WEBHOOK_SECRET=
ZAPSIGN_TEMPLATE_HONORARIOS_ID=
# URL pública do funil — monta o link de aprovação 1-toque e o webhook ZapSign
FUNIL_BASE_URL=

# Juridiq (gestão de processos) — intake do lead/cliente, tarefas. Chave no
# painel Juridiq. Vazio = features Juridiq off.
JURIDIQ_API_KEY=
JURIDIQ_BASE_URL=https://api.juridiq.com.br

# AASP — recorte de intimações (intimacaoapi.aasp.org.br) → andamento [AASP]
# no processo do Juridiq (job noviello-aasp). Chave fornecida pela AASP no
# portal do associado. Vazio = job pula.
AASP_CHAVE=
# #36: pós-assinatura ZapSign (intake + arquivo PDF + tarefa). Default off; só
# ligar após smoke em sandbox. Exige JURIDIQ_API_KEY.
POS_ASSINATURA_ATIVO=false

# Asaas — cobrança de honorários no fechamento (pipeline). CONTRATOS_ASAAS liga
# (default off). Auth é header access_token (sandbox $aact_hmlg_..., prod
# $aact_prod_...). Sandbox-first: api-sandbox.asaas.com não cobra de verdade.
# ASAAS_WEBHOOK_TOKEN = valor longo aleatório que volta no header de cada webhook
# (a Asaas não assina com HMAC). Só CRIA/CANCELA cobrança — nunca estorno/saque.
CONTRATOS_ASAAS=false
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=
ASAAS_PAYMENT_DUE_DAYS=7

# Signatários FIXOS do contrato: escritório (você, order_group 2) + 2 testemunhas
# (order_group 3, tornam o contrato executável). CPF/email são PII — preencher só
# no .env do VPS, nunca commitar valor real.
CONTRATO_ESCRITORIO_NOME=
CONTRATO_ESCRITORIO_EMAIL=
CONTRATO_ESCRITORIO_CPF=
CONTRATO_TESTEMUNHA_1_NOME=
CONTRATO_TESTEMUNHA_1_EMAIL=
CONTRATO_TESTEMUNHA_1_CPF=
CONTRATO_TESTEMUNHA_2_NOME=
CONTRATO_TESTEMUNHA_2_EMAIL=
CONTRATO_TESTEMUNHA_2_CPF=
